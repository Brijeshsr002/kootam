# Copy to .env.local and fill in. NEVER commit .env.local.
# Full explanation of every variable: docs/ENVIRONMENT.md

# --- App -------------------------------------------------------------------
# Public base URL. Local: http://localhost:3000 · Production: https://<your-domain>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "publishable" (sb_publishable_...) or legacy "anon" key — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "secret" (sb_secret_...) or legacy "service_role" key — SERVER ONLY, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=

# --- Login options ---------------------------------------------------------
# "true" only after an SMS provider is set up in Supabase (India needs DLT).
# Until then members log in with Google or email.
NEXT_PUBLIC_PHONE_AUTH_ENABLED=false

# --- SEO (optional) --------------------------------------------------------
# Google Search Console → HTML tag method → the content="…" value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Razorpay (Phase 4) ----------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- n8n (Phase 6, optional — registration works without it) ---------------------
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Google OAuth Client ID/Secret and SMS provider credentials are NOT set here.
# They are entered in the Supabase dashboard (Authentication → Sign In / Providers).
